<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="jetrover">
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="back_shell_black_link" link2="back_shell_green_link" reason="Default"/>
    <disable_collisions link1="back_shell_black_link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="back_shell_black_link" link2="imu_link" reason="Never"/>
    <disable_collisions link1="back_shell_black_link" link2="link1" reason="Never"/>
    <disable_collisions link1="back_shell_black_link" link2="servo_link1" reason="Never"/>
    <disable_collisions link1="back_shell_black_link" link2="wheel_left_back_link" reason="Never"/>
