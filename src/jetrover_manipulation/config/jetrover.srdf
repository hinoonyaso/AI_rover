  <disable_collisions link1="link1" link2="wheel_left_front_link" reason="Never"/>
  <disable_collisions link1="link1" link2="wheel_right_back_link" reason="Never"/>
  <disable_collisions link1="link1" link2="wheel_right_front_link" reason="Never"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link4" reason="Never"/>
  <disable_collisions link1="link2" link2="link5" reason="Never"/>
  <disable_collisions link1="link2" link2="servo_link1" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="link2" link2="wheel_left_back_link" reason="Never"/>
  <disable_collisions link1="link2" link2="wheel_left_front_link" reason="Never"/>
  <disable_collisions link1="link2" link2="wheel_right_back_link" reason="Never"/>
  <disable_collisions link1="link2" link2="wheel_right_front_link" reason="Never"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link3" link2="r_in_link" reason="Never"/>
  <disable_collisions link1="link3" link2="r_link" reason="Never"/>
  <disable_collisions link1="link3" link2="r_out_link" reason="Never"/>
  <disable_collisions link1="link3" link2="servo_link1" reason="Never"/>
  <disable_collisions link1="link4" link2="link5" reason="Never"/>
  <disable_collisions link1="link4" link2="r_in_link" reason="Never"/>
  <disable_collisions link1="link4" link2="r_link" reason="Never"/>
  <disable_collisions link1="link4" link2="r_out_link" reason="Never"/>
  <disable_collisions link1="link4" link2="servo_link1" reason="Never"/>
  <disable_collisions link1="link4" link2="servo_link2" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="r_in_link" reason="Never"/>
  <disable_collisions link1="link5" link2="r_link" reason="Never"/>
  <disable_collisions link1="link5" link2="r_out_link" reason="Never"/>
  <disable_collisions link1="link5" link2="servo_link1" reason="Never"/>
  <disable_collisions link1="link5" link2="servo_link2" reason="Adjacent"/>
  <disable_collisions link1="r_in_link" link2="r_out_link" reason="Adjacent"/>
  <disable_collisions link1="r_in_link" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="r_link" link2="r_out_link" reason="Default"/>
  <disable_collisions link1="r_link" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="r_out_link" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="servo_link1" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="servo_link1" link2="wheel_left_back_link" reason="Never"/>
  <disable_collisions link1="servo_link1" link2="wheel_left_front_link" reason="Never"/>
  <disable_collisions link1="servo_link1" link2="wheel_right_back_link" reason="Never"/>
  <disable_collisions link1="servo_link1" link2="wheel_right_front_link" reason="Never"/>
  <disable_collisions link1="wheel_left_back_link" link2="wheel_left_front_link" reason="Never"/>
  <disable_collisions link1="wheel_left_back_link" link2="wheel_right_back_link" reason="Never"/>
  <disable_collisions link1="wheel_left_back_link" link2="wheel_right_front_link" reason="Never"/>
  <disable_collisions link1="wheel_left_front_link" link2="wheel_right_back_link" reason="Never"/>
  <disable_collisions link1="wheel_left_front_link" link2="wheel_right_front_link" reason="Never"/>
  <disable_collisions link1="wheel_right_back_link" link2="wheel_right_front_link" reason="Never"/>
  <!-- 한글: 이전 보수적 목록에만 있던 쌍(주로 그리퍼 링크 연동부). 생성기는 기본 자세에서만 보므로 그리퍼 개폐 상태에서 접촉하는 쌍(l_in-l_link 등)이 빠졌다 -->
  <!-- Pairs only in the earlier list (mostly gripper linkage); the generator samples the default gripper state and missed pairs that touch when it opens/closes. -->
  <disable_collisions link1="camera_connect_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="depth_cam_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="camera_connect_link" link2="l_link" reason="Never"/>
  <disable_collisions link1="link5" link2="end_effector_link" reason="Adjacent"/>
  <disable_collisions link1="l_in_link" link2="r_in_link" reason="Never"/>
  <disable_collisions link1="l_link" link2="l_in_link" reason="Adjacent"/>
  <disable_collisions link1="r_link" link2="r_in_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="l_out_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="r_out_link" reason="Adjacent"/>
  <disable_collisions link1="l_in_link" link2="r_out_link" reason="Never"/>
  <disable_collisions link1="r_in_link" link2="l_out_link" reason="Never"/>
  <disable_collisions link1="l_link" link2="r_in_link" reason="Never"/>
  <disable_collisions link1="r_link" link2="l_in_link" reason="Never"/>
  <disable_collisions link1="l_link" link2="r_out_link" reason="Never"/>
  <disable_collisions link1="r_link" link2="l_out_link" reason="Never"/>
  <disable_collisions link1="l_out_link" link2="r_in_link" reason="Never"/>
  <disable_collisions link1="r_out_link" link2="l_in_link" reason="Never"/>
  <disable_collisions link1="l_in_link" link2="r_link" reason="Never"/>
  <disable_collisions link1="r_in_link" link2="l_link" reason="Never"/>
</robot>
