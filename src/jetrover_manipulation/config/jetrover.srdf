<?xml version="1.0" encoding="UTF-8"?>
<!-- 한글: JetRover 팔 SRDF. 참고 ~/AI_secretary_robot/.../jetrover_arm_moveit/config/jetrover_arm.srdf (Humble)를
     Jazzy용으로 정리: 그리퍼(r_joint)를 팔 그룹에서 분리하고 home 자세를 실기 주행 자세로 맞춤.
     충돌 매트릭스는 host의 Setup Assistant(Self-Collisions)가 생성한 것이다(2026-10-06). 링크가 바뀌면
     다시 생성할 것. / Collision matrix generated by the Setup Assistant; regenerate if links change.
     -->
<robot name="jetrover">
  <!-- 한글: virtual_joint(world -> base_footprint)를 뺐다(2026-10-06). 'world' 프레임은 TF에 없고(발행자 없음), base_footprint는 이미 odom의 자식이라
       world를 부모로 발행하면 TF 부모가 둘이 된다. 그 상태로는 RViz의 끌어서 옮기는 마커(planning frame=world)가 "Frame [world] does not exist"로 안 보인다.
       빼면 planning frame이 URDF 루트(base_footprint)가 된다. / Removed virtual_joint: `world` is not in TF and base_footprint already has the
       parent odom, so the RViz drag marker (published in the planning frame) had no valid frame; the planning frame is now the URDF root. -->

  <!-- 한글: arm = base_link에서 end_effector_link까지 체인(joint1~5, link5 앞 0.08 m가 끝단) -->
  <group name="arm">
    <chain base_link="base_link" tip_link="end_effector_link"/>
  </group>
  <group name="gripper">
    <joint name="r_joint"/>
  </group>

  <!-- 한글: 주행용 홈 자세(base.yaml arm_home_pose_rad, 2026-10-06 확정)와 같은 값 -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0.0042"/>
    <joint name="joint2" value="-0.6618"/>
    <joint name="joint3" value="1.6629"/>
    <joint name="joint4" value="1.6043"/>
    <joint name="joint5" value="0.0168"/>
  </group_state>
  <group_state name="gripper_closed" group="gripper">
    <joint name="r_joint" value="-0.0209"/>
  </group_state>

  <!-- 한글: RViz의 끌어서 옮기는 마커용 end effector. 그룹 hand는 gripper_link 하나뿐인 "링크 그룹"이고(Panda의 hand 그룹과 같은 방식),
       마커는 parent_link(= arm 체인 끝 end_effector_link)의 자세를 IK로 푼다. gripper 그룹(r_joint)은 손가락 계획용으로 따로 둔다.
       End effector for the RViz drag marker: group `hand` is a links-only group (like Panda's), and the marker drives
       parent_link (the arm chain tip). The `gripper` joint group stays separate for finger planning. -->
  <group name="hand">
    <link name="gripper_link"/>
  </group>
  <end_effector name="tool" parent_link="end_effector_link" group="hand" parent_group="arm"/>

  <!-- 한글: Setup Assistant(host, 2026-10-06, density 10000, 95 pct)가 만든 자기충돌 면제 목록 126쌍. 이전 보수적 목록을 대체. -->
  <!-- Self-collision exemptions generated by MoveIt Setup Assistant (replaces the earlier conservative list). -->
  <disable_collisions link1="back_shell_black_link" link2="back_shell_green_link" reason="Default"/>
  <disable_collisions link1="back_shell_black_link" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="back_shell_black_link" link2="imu_link" reason="Never"/>
  <disable_collisions link1="back_shell_black_link" link2="link1" reason="Never"/>
  <disable_collisions link1="back_shell_black_link" link2="servo_link1" reason="Never"/>
  <disable_collisions link1="back_shell_black_link" link2="wheel_left_back_link" reason="Never"/>
  <disable_collisions link1="back_shell_black_link" link2="wheel_left_front_link" reason="Never"/>
  <disable_collisions link1="back_shell_black_link" link2="wheel_right_back_link" reason="Never"/>
  <disable_collisions link1="back_shell_black_link" link2="wheel_right_front_link" reason="Never"/>
  <disable_collisions link1="back_shell_green_link" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="back_shell_green_link" link2="imu_link" reason="Never"/>
  <disable_collisions link1="back_shell_green_link" link2="link1" reason="Default"/>
  <disable_collisions link1="back_shell_green_link" link2="servo_link1" reason="Never"/>
  <disable_collisions link1="back_shell_green_link" link2="wheel_left_back_link" reason="Never"/>
  <disable_collisions link1="back_shell_green_link" link2="wheel_left_front_link" reason="Never"/>
  <disable_collisions link1="back_shell_green_link" link2="wheel_right_back_link" reason="Never"/>
  <disable_collisions link1="back_shell_green_link" link2="wheel_right_front_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="imu_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link2" reason="Never"/>
  <disable_collisions link1="base_link" link2="servo_link1" reason="Never"/>
  <disable_collisions link1="base_link" link2="wheel_left_back_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_left_front_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_right_back_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_right_front_link" reason="Adjacent"/>
  <disable_collisions link1="camera_connect_link" link2="depth_cam_link" reason="Adjacent"/>
  <disable_collisions link1="camera_connect_link" link2="l_in_link" reason="Never"/>
  <disable_collisions link1="camera_connect_link" link2="l_out_link" reason="Never"/>
  <disable_collisions link1="camera_connect_link" link2="link1" reason="Never"/>
  <disable_collisions link1="camera_connect_link" link2="link3" reason="Never"/>
  <disable_collisions link1="camera_connect_link" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="camera_connect_link" link2="link5" reason="Never"/>
  <disable_collisions link1="camera_connect_link" link2="r_in_link" reason="Never"/>
  <disable_collisions link1="camera_connect_link" link2="r_out_link" reason="Never"/>
  <disable_collisions link1="camera_connect_link" link2="servo_link1" reason="Never"/>
  <disable_collisions link1="camera_connect_link" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="depth_cam_link" link2="l_in_link" reason="Never"/>
  <disable_collisions link1="depth_cam_link" link2="link3" reason="Never"/>
  <disable_collisions link1="depth_cam_link" link2="link4" reason="Never"/>
  <disable_collisions link1="depth_cam_link" link2="link5" reason="Never"/>
  <disable_collisions link1="depth_cam_link" link2="r_in_link" reason="Never"/>
  <disable_collisions link1="depth_cam_link" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="gripper_link" link2="l_in_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="l_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="link3" reason="Never"/>
  <disable_collisions link1="gripper_link" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_link" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="r_in_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="r_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="imu_link" link2="link1" reason="Never"/>
  <disable_collisions link1="imu_link" link2="link2" reason="Never"/>
  <disable_collisions link1="imu_link" link2="servo_link1" reason="Never"/>
  <disable_collisions link1="imu_link" link2="wheel_left_back_link" reason="Never"/>
  <disable_collisions link1="imu_link" link2="wheel_left_front_link" reason="Never"/>
  <disable_collisions link1="imu_link" link2="wheel_right_back_link" reason="Never"/>
  <disable_collisions link1="imu_link" link2="wheel_right_front_link" reason="Never"/>
  <disable_collisions link1="l_in_link" link2="l_out_link" reason="Adjacent"/>
  <disable_collisions link1="l_in_link" link2="link2" reason="Never"/>
  <disable_collisions link1="l_in_link" link2="link3" reason="Never"/>
  <disable_collisions link1="l_in_link" link2="link4" reason="Never"/>
  <disable_collisions link1="l_in_link" link2="link5" reason="Never"/>
  <disable_collisions link1="l_in_link" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="l_link" link2="l_out_link" reason="Default"/>
  <disable_collisions link1="l_link" link2="link3" reason="Never"/>
  <disable_collisions link1="l_link" link2="link4" reason="Never"/>
  <disable_collisions link1="l_link" link2="link5" reason="Never"/>
  <disable_collisions link1="l_link" link2="r_link" reason="Default"/>
  <disable_collisions link1="l_link" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="l_out_link" link2="link3" reason="Never"/>
  <disable_collisions link1="l_out_link" link2="link4" reason="Never"/>
  <disable_collisions link1="l_out_link" link2="link5" reason="Never"/>
  <disable_collisions link1="l_out_link" link2="r_out_link" reason="Default"/>
  <disable_collisions link1="l_out_link" link2="servo_link2" reason="Never"/>
  <disable_collisions link1="link1" link2="link2" reason="Never"/>
