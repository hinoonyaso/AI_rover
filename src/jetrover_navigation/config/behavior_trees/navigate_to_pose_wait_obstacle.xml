<!--
  2026-10-22 (checklist 8.16): copy of navigate_to_pose_no_backup.xml with a PathLongerOnApproach
  "stop and wait" in front of FollowPath (see the comment there). Used only by the sim variant
  tools/nav/ab_params/nav2_params_dyn_wait.yaml for now. 한글: 막히면 멈추고 기다리는 sim 시험용 BT.
  ===== original header of navigate_to_pose_no_backup.xml =====
  nav2_bt_navigator's default navigate_to_pose_w_replanning_and_recovery.xml, with the
  <BackUp .../> recovery action removed (troubleshooting/022, 2026-10-05): the robot's rear
  is a total sensor blind spot (LiDAR occluded ~160 deg by the arm, the new depth_cloud camera
  source only covers the front), so a recovery-triggered backup drove straight into an object
  placed in front of the robot with nothing watching behind it. Keep this in sync with upstream
  nav2_bt_navigator's default if it changes; the only diff from the original is BackUp removed
  from the RecoveryActions RoundRobin.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="0.5">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <!-- 2026-10-22 (8.16 동적 장애물, sim 시험용): 경로가 갑자기 길어지면(장애물이 막아 돌아가야 함) 주행을 멈추고 기다린다.
             Nav2 navigate_to_pose_w_replanning_goal_patience_and_recovery.xml과 같은 방식. 기다린 뒤에도 막혀 있으면 긴 경로로 간다.
             Stop and wait when the replanned path suddenly gets longer (something blocks the way), as in nav2's goal_patience BT. -->
        <ReactiveSequence name="MonitorAndFollowPath">
          <!-- 2026-10-22 H5: length_factor 1.1 -> 1.2, wait 5.0 -> 3.0 s. 1.1/5 s는 상자가 점점 더 보이며 경로가 두 번 길어져 9~12 s 기다렸고(D4),
               지나가는 상자에도 5 s를 다 채워 재출발이 2.1 s 늦었다(D3). / waited twice (9-12 s) and resumed late with 1.1 / 5 s -->
          <PathLongerOnApproach path="{path}" prox_len="3.0" length_factor="1.2">
            <RetryUntilSuccessful num_attempts="1">
              <SequenceWithMemory name="CancelingControlAndWait">
                <CancelControl name="ControlCancel"/>
                <Wait wait_duration="3.0"/>
              </SequenceWithMemory>
            </RetryUntilSuccessful>
          </PathLongerOnApproach>
          <RecoveryNode number_of_retries="1" name="FollowPath">
            <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
            <Sequence>
              <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
              <!-- 2026-10-06: 로컬 costmap 비우기 제거(상자 기억 보존). 대신 1초 대기 후 같은 경로로 재시도 -->
              <Wait wait_duration="1.0"/>
            </Sequence>
          </RecoveryNode>
        </ReactiveSequence>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <!-- 2026-10-06: ClearingActions 제거. 비용 맵을 비우면 옆으로 벗어나 안 보이는 상자 기억까지 지워져 경로가 다시 상자를 가로지르며 좌우를 반복했다 -->
            <!-- 2026-10-06: Spin 제거. 상자 옆에서 제자리 회전하면 모서리가 휩쓸려 위험하고 자세가 어긋났다 -->
            <Wait wait_duration="5.0"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
