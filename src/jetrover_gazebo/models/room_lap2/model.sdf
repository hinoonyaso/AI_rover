<?xml version="1.0"?>
<!-- Scanned room in the MAP frame of maps/lap2_20261005 (after tools/scan/validate_room_alignment.py).
     meshes/room_visual.dae (or .glb): detailed, textured.  meshes/room_collision.stl: simplified (boxes/low-poly).
     Assets come from the host (Blender) through Git LFS; until then this model is a placeholder.
     한글: 지도 좌표계의 스캔 방 모델. 시각 메쉬(상세)와 충돌 메쉬(단순)를 따로. 에셋은 host에서 Git LFS로. -->
<sdf version="1.9">
  <model name="room_lap2">
    <static>true</static>
    <link name="room">
      <visual name="room_visual">
        <geometry><mesh><uri>model://room_lap2/meshes/room_visual.dae</uri></mesh></geometry>
      </visual>
      <collision name="room_collision">
        <geometry><mesh><uri>model://room_lap2/meshes/room_collision.stl</uri></mesh></geometry>
      </collision>
    </link>
  </model>
</sdf>
