# Groq 무료 등급을 선택하면 콘솔에서 발급한 키를 .env에 입력합니다.
VOICE_CLOUD_BASE_URL=https://api.groq.com/openai/v1
VOICE_CLOUD_MODEL=openai/gpt-oss-20b
VOICE_CLOUD_API_KEY=
# 로컬 파일 경로는 기본적으로 ~/.local/share/jetrover-voice 를 사용합니다.

# VLM 키/주소를 비우면 위 클라우드 설정을 사용합니다.
VOICE_VISION_BASE_URL=
VOICE_VISION_API_KEY=
VOICE_VISION_MODEL=qwen/qwen3.8-27b
