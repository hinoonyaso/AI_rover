# Persistent local Korean STT (whisper.cpp small, CUDA) on loopback only.
# 한글: 루프백 전용 상시 로컬 한국어 STT(whisper.cpp small, CUDA).
# Install: cp to ~/.config/systemd/user/ && systemctl --user enable --now jetrover-whisper
[Unit]
Description=JetRover local Whisper STT server (loopback)

[Service]
Type=simple
ExecStart=%h/.local/share/jetrover-voice/src/whisper.cpp/build-cuda/bin/whisper-server -m %h/.local/share/jetrover-voice/models/ggml-small.bin -l ko -t 4 --host 127.0.0.1 --port 8178
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
