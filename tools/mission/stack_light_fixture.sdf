<?xml version="1.0"?>
<!-- Isolated camera fixture, not a navigation world. / 격리 카메라 시험 월드이며 주행 월드가 아니다. -->
<sdf version="1.9">
  <world name="stack_light_fixture">
    <physics name="default" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <model name="camera"><static>true</static><pose>0 0 1 0 0 0</pose><link name="link">
      <sensor name="rgb" type="camera"><always_on>true</always_on><update_rate>10</update_rate>
        <topic>/stack_test/image</topic><camera><horizontal_fov>1.0</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>5</far></clip>
        </camera>
      </sensor>
    </link></model>
    <model name="stack_light"><static>true</static><link name="link">
      <visual name="red"><pose>1 0 1.15 0 0 0</pose><geometry><box><size>0.02 0.10 0.10</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material></visual>
      <visual name="yellow"><pose>1 0 1 0 0 0</pose><geometry><box><size>0.02 0.10 0.10</size></box></geometry>
        <material><ambient>0.025 0.025 0 1</ambient><diffuse>0.025 0.025 0 1</diffuse><emissive>0.025 0.025 0 1</emissive></material></visual>
      <visual name="green_off"><pose>1.01 0 0.85 0 0 0</pose><geometry><box><size>0.02 0.10 0.10</size></box></geometry>
        <material><ambient>0 0.025 0 1</ambient><diffuse>0 0.025 0 1</diffuse><emissive>0 0.025 0 1</emissive></material></visual>
    </link></model>
    <!-- Move only this simulated visual to reveal the dim lens. / 밝은 모형을 이동해 소등 렌즈를 드러낸다. -->
    <model name="green_on"><static>true</static><pose>0.98 0 0.85 0 0 0</pose><link name="link">
      <visual name="lens"><geometry><box><size>0.02 0.10 0.10</size></box></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 1 0 1</emissive></material></visual>
    </link></model>
  </world>
</sdf>
