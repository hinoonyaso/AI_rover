[Unit]
Description=JetInspect base sensor-only reader (manual start)

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=25
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source %h/jetrover_ws/install/setup.bash && exec ros2 run jetrover_base base_node --ros-args --params-file %h/jetrover_ws/install/jetrover_base/share/jetrover_base/config/base.yaml -p sensor_only:=true -p arm_command_enabled:=false -p clear_estop_on_start:=false -p publish_arm_joint_states:=false'
Restart=no
NoNewPrivileges=true

[Install]
WantedBy=default.target
