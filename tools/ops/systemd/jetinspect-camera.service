[Unit]
Description=JetInspect camera sensor driver (manual start)

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=25
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source %h/jetrover_ws/install/setup.bash && exec /usr/bin/python3 %h/jetrover_ws/tools/ops/calibration/camera_source_launch.py'
Restart=no
NoNewPrivileges=true

[Install]
WantedBy=default.target
