[Unit]
Description=JetInspect LiDAR sensor driver (manual start)

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=25
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source %h/jetrover_ws/install/setup.bash && exec ros2 launch jetrover_bringup lidar.launch.py'
Restart=no
NoNewPrivileges=true

[Install]
WantedBy=default.target
