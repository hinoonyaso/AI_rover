[Unit]
Description=JetInspect isolated Gazebo pose monitor

[Service]
Type=simple
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash; source %h/jetrover_ws/install/setup.bash; unset ROS_STATIC_PEERS ROS_DISCOVERY_SERVER FASTDDS_DEFAULT_PROFILES_FILE CYCLONEDDS_URI FASTDDS_BUILTIN_TRANSPORTS ROS_LOCALHOST_ONLY; export ROS_DOMAIN_ID=31 ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET RMW_IMPLEMENTATION=rmw_fastrtps_cpp GZ_IP=127.0.0.1 FASTRTPS_DEFAULT_PROFILES_FILE=%h/jetrover_ws/tools/mission/fastdds-loopback.xml; exec /usr/bin/python3 %h/jetrover_ws/tools/ops/backend/gazebo_pose_monitor.py'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
