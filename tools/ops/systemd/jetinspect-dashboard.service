[Unit]
Description=JetInspect read-only operations dashboard
After=jetinspect-mysql.service
Wants=jetinspect-mysql.service

[Service]
Type=simple
WorkingDirectory=%h/jetrover_ws/tools/ops/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/.local/share/jetinspect-ops/tls/lan.env
ExecStart=%h/.local/share/jetinspect-ops/venv/bin/python -m uvicorn app:app --host ${JETINSPECT_LAN_IP} --port 8765 --ssl-keyfile %h/.local/share/jetinspect-ops/tls/dashboard.key --ssl-certfile %h/.local/share/jetinspect-ops/tls/dashboard.crt --no-proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
