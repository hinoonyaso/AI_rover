# colcon build output (workspace root and any accidental build inside src/)
/build/
/install/
/log/
/src/build/
/src/install/
/src/log/

# Orbbec SDK runtime log (written to the launch directory)
/Log/

# Vendor source with its own git history: clone it separately (see README)
/src/OrbbecSDK_ROS2/

# Python
__pycache__/
*.py[cod]

# Generated images (snapshot.py output)
/tools/viz/out/

# SLAM Toolbox serialized maps (large, regenerated by driving a lap); keep the small .pgm/.yaml/.png
/maps/*.posegraph
/maps/*.data

# Hiwonder vendor material (firmware .hex ZIP, protocol PDF): license unclear, keep local only.
# Our own docs/backups in this folder (BOARD_CONNECTORS.md, dumped .bin) are NOT ignored.
/firmware_source/RosRobotControllerM4.zip
/firmware_source/*.pdf

# CMake build output for the STM32 firmware rewrite project
/firmware/rrc_m4/build/

# Kernel module build artifacts (keep ch341.c, Makefile, install.sh, README.md)
/drivers/ch341/*.ko
/drivers/ch341/*.o
/drivers/ch341/*.mod
/drivers/ch341/*.mod.c
/drivers/ch341/*.mod.o
/drivers/ch341/.*.cmd
/drivers/ch341/Module.symvers
/drivers/ch341/modules.order

# rosbag recordings
*.bag
*.mcap
*.db3
rosbag2_*/

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Secrets
.env
*.env
*.pem
*.key
